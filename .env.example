# Server-side only. Obtain a private Storefront API token from Shopify's Headless channel.
# Do not use an Admin API token or prefix these names with VITE_.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

# Generate local access with npm run admin:setup. Set these as server secrets when deploying.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
